# Copy to .env and export the variables you need. Do not commit .env.
# Shipyard does not load this file by itself. `shipyard connect` reads the
# variables below when you pass the matching flag, or when the flag is omitted.

# Vercel API token for an account you already own.
# https://vercel.com/account/tokens
VERCEL_TOKEN=your-vercel-token

# Optional Vercel team id (team_...).
VERCEL_TEAM_ID=your-vercel-team-id

# OAuth client for `shipyard connect vercel --oauth`.
# Leave these as placeholders until you register an OAuth app.
VERCEL_OAUTH_CLIENT_ID=your-vercel-oauth-client-id
VERCEL_OAUTH_CLIENT_SECRET=your-vercel-oauth-client-secret
VERCEL_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/callback

# Existing GCP project. Shipyard does not create projects.
GCP_PROJECT=your-gcp-project-id

# Access token for that project, if you are not using a service-account file.
GCP_TOKEN=your-gcp-access-token

# Path to a service-account JSON key you already created. chmod 600 the file.
GCP_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# OAuth client for `shipyard connect gcp --oauth`.
GCP_OAUTH_CLIENT_ID=your-gcp-oauth-client-id
GCP_OAUTH_CLIENT_SECRET=your-gcp-oauth-client-secret
GCP_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/callback

# Optional. Defaults to europe-west1 (EU).
SHIPYARD_REGION=europe-west1

# Optional. Defaults to fake so a fresh checkout never calls a cloud API.
SHIPYARD_PROVIDER=fake

# Optional company domain reserved for the login gate (not enforced yet).
SHIPYARD_ORG_DOMAIN=example.com
